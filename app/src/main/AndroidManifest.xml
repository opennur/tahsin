<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic untuk membaca Al-Quran (STT) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Getar saat ada kesalahan pengucapan (umpan muroja'ah) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- STT online (SpeechRecognizer bawaan) — offline kalau paket bahasa Arab terpasang -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifikasi progres unduhan (foreground service) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wake lock: unduhan tetap jalan saat layar mati -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service (wajib Android 14+ / targetSdk 34) + tipe dataSync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Reschedule alarm harian "Ayah of the Day" setelah perangkat restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TahsinQuran">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Menjaga unduhan tetap berjalan saat layar mati / app di background -->
        <service
            android:name=".util.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Widget "Ayah of the Day" (home screen) -->
        <receiver
            android:name=".widget.AyahOfTheDayWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ayah_of_the_day_widget_info" />
        </receiver>

        <!-- Alarm harian (update widget + notifikasi) + reschedule saat boot -->
        <receiver
            android:name=".widget.AyahOfTheDayAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.opennur.tahsin.action.UPDATE_AYAH_OF_THE_DAY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Pengingat streak harian (jam 18:00) + reschedule saat boot -->
        <receiver
            android:name=".widget.StreakReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.opennur.tahsin.action.STREAK_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
