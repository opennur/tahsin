        { "number": 2, "text": "مِنْ شَرِّ مَا خَلَقَۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/113002.mp3" },
        { "number": 3, "text": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/113003.mp3" },
        { "number": 4, "text": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِى الْعُقَدِۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/113004.mp3" },
        { "number": 5, "text": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ࣖ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/113005.mp3" }
