      "nameLatin": "Al-Ikhlas",
      "ayahs": [
        { "number": 1, "text": "قُلْ هُوَ اللّٰهُ اَحَدٌۚ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/112001.mp3" },
        { "number": 2, "text": "اَللّٰهُ الصَّمَدُۚ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/112002.mp3" },
        { "number": 3, "text": "لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/112003.mp3" },
        { "number": 4, "text": "وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/112004.mp3" }
      ]
    },
    {
