      "ayahs": [
        { "number": 1, "text": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001001.mp3" },
        { "number": 2, "text": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001002.mp3" },
        { "number": 3, "text": "الرَّحْمٰنِ الرَّحِيْمِۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001003.mp3" },
        { "number": 4, "text": "مٰلِكِ يَوْمِ الدِّيْنِۗ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001004.mp3" },
        { "number": 5, "text": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُۗ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001005.mp3" },
        { "number": 6, "text": "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَۙ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001006.mp3" },
        { "number": 7, "text": "صِرَاطَ الَّذِيْنَ اَنْعَمْتَ عَلَيْهِمْ ەۙ غَيْرِ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّاۤلِّيْنَ ࣖ", "audioUrl": "https://everyayah.com/data/Minshawy_Murattal_128kbps/001007.mp3" }
      ]
    },
    {
